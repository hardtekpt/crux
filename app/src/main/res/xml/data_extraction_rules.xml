<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup. Nothing goes to cloud backup: Crux keeps your data on your phone, and its
    own backups (by hand, or automatic to a folder you pick) are how you keep a copy.
    Phone-to-phone transfer, which stays between your devices, brings the database, settings,
    photos and videos. The demo database is left out: it is seeded again on first launch.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="crux-user.db" />
        <include domain="database" path="crux-user.db-wal" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="area_images/" />
    </device-transfer>
</data-extraction-rules>
